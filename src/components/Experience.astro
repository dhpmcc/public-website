---
import SectionHeading from './SectionHeading.astro';
import { competitionLoop } from '../config/site';
---

<section class="content-section" id="experience">
  <SectionHeading
    number="05"
    title="Competition Experience"
    subtitle="How an algorithmic programming contest runs from problem delivery to final judgment."
  />

  <p class="section-intro">
    DHPMCC is operated using a rigorous competitive programming contest environment. Participants work independently on their local workstations, solving problems using standard algorithmic paradigms and automated judging pipelines.
  </p>

  <div class="process-grid">
    {competitionLoop.map((stage) => (
      <div class="process-card">
        <div class="process-header">
          <span class="process-step mono">{stage.step}</span>
          <span class="process-tag mono">{stage.tag}</span>
        </div>
        <h3 class="process-title">{stage.title}</h3>
        <p class="process-desc">{stage.description}</p>
      </div>
    ))}
  </div>

  <div class="experience-footer mono">
    <div class="terminal-status">
      <span class="prompt-symbol">&gt;</span> CONTEST PIPELINE: LOCAL DEV &rarr; ONLINE JUDGE &rarr; SANDBOXED RUNTIME &rarr; AUTOMATED VERDICT
    </div>
  </div>
</section>

<style>
  .content-section {
    margin-bottom: 3.5rem;
  }

  .section-intro {
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 75ch;
    margin-bottom: 1.5rem;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--border);
    background-color: var(--bg-surface);
  }

  .process-card {
    padding: 1.5rem 1.25rem;
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
  }

  .process-card:last-child {
    border-right: none;
  }

  .process-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .process-step {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-dim);
  }

  .process-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    background-color: var(--accent-light);
    border: 1px solid var(--accent-border);
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
    letter-spacing: 0.05em;
  }

  .process-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .process-desc {
    font-size: 0.86rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .experience-footer {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    background-color: var(--bg-subtle);
    border: 1px solid var(--border);
    font-size: 0.78rem;
    color: var(--text-secondary);
    border-radius: 2px;
  }

  .prompt-symbol {
    color: var(--accent);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-card:nth-child(2) {
      border-right: none;
    }

    .process-card:nth-child(1),
    .process-card:nth-child(2) {
      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 520px) {
    .process-grid {
      grid-template-columns: 1fr;
    }

    .process-card {
      border-right: none !important;
      border-bottom: 1px solid var(--border);
    }

    .process-card:last-child {
      border-bottom: none;
    }
  }
</style>
