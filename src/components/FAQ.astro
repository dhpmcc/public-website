---
import SectionHeading from './SectionHeading.astro';
import { faqs } from '../config/site';
---

<section id="faq">
  <SectionHeading
    number="04"
    title="Frequently Asked Questions"
    subtitle="Operational, technical, and logistical information regarding DHPMCC."
  />

  <div>
    {faqs.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>
