---
import { siteConfig } from '../config/site';
---

<footer>
  <hr />
  <div>
    <p>
      <strong>{siteConfig.shortName} // {siteConfig.year}</strong><br />
      {siteConfig.fullName}<br />
      {siteConfig.location} &bull; {siteConfig.venueDetail}
    </p>
  </div>

  <nav>
    <ul>
      {siteConfig.navItems.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div>
    <p>&copy; {siteConfig.year} {siteConfig.shortName}. All rights reserved.</p>
  </div>
</footer>
