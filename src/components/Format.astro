---
import SectionHeading from './SectionHeading.astro';
import { supportedLanguages } from '../config/site';
---

<section id="format" class="format-section">
  <!-- Anchor so any links to #languages continue to work -->
  <div id="languages" class="anchor-offset"></div>

  <div class="content-container">
    <SectionHeading
      title="How it works"
    />

    <div class="format-content">
      <div class="format-cards-grid">
        <div class="format-card">
          <span class="card-eyebrow">INDIVIDUAL</span>
          <h3 class="card-title">Compete on your own</h3>
          <p class="card-text">
            Every competitor solves the problems alone. No teams, no outside help during the round.
          </p>
        </div>

        <div class="format-card">
          <span class="card-eyebrow">ALGORITHMIC</span>
          <h3 class="card-title">Original problems</h3>
          <p class="card-text">
            Problems are written for DHPMCC. Expect the full range: from careful implementation to problems that need a genuinely clever algorithm.
          </p>
        </div>
      </div>

      <div class="languages-block">
        <h3 class="languages-title">Languages &amp; versions</h3>
        <div class="table-responsive">
          <table class="languages-table">
            <thead>
              <tr>
                <th scope="col" class="lang-head">Language</th>
                <th scope="col" class="version-head">Version / Standard</th>
              </tr>
            </thead>
            <tbody>
              {supportedLanguages.map((lang) => (
                <tr>
                  <td class="lang-col">
                    <span class="lang-name">{lang.name}</span>
                  </td>
                  <td class="version-col">
                    <code class="version-badge">{lang.standard}</code>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .format-section {
    width: 100%;
    background-color: #f8fafc;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    padding: 6.5rem 0;
    position: relative;
  }

  .anchor-offset {
    position: absolute;
    top: -70px;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .format-content {
    max-width: 980px;
    margin: 0 auto;
  }

  /* Two feature cards side-by-side */
  .format-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .format-card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2.25rem;
    text-align: left;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .format-card:hover {
    transform: translateY(-3px);
    border-color: #cbd5e1;
    box-shadow: 0 12px 28px -4px rgba(0, 0, 0, 0.08);
  }

  /* Clean, natural text eyebrow - no rounded radio/status pill */
  .card-eyebrow {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8b0000;
    margin-bottom: 0.45rem;
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.65rem 0;
    line-height: 1.3;
  }

  .card-text {
    font-size: 1.02rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  /* Languages & versions block */
  .languages-block {
    margin-top: 3.5rem;
  }

  .languages-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 1.25rem 0;
    text-align: left;
  }

  .table-responsive {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background-color: #ffffff;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
    margin: 0;
  }

  .languages-table {
    border-collapse: collapse;
    width: 100%;
    min-width: 340px;
    margin: 0;
  }

  .languages-table th,
  .languages-table td {
    padding: 15px 22px;
    text-align: left;
    border-bottom: 1px solid #f1f5f9;
  }

  .languages-table tr:last-child td {
    border-bottom: none;
  }

  .languages-table th {
    background-color: #0f172a;
    color: #ffffff;
    font-weight: 600;
    letter-spacing: 0.02em;
    font-size: 0.92rem;
  }

  .lang-head {
    width: 35%;
  }

  .version-head {
    width: 65%;
  }

  .languages-table tbody tr {
    background-color: #ffffff;
    transition: background-color 0.15s ease;
  }

  .languages-table tbody tr:hover {
    background-color: #f8fafc;
  }

  .lang-name {
    color: #0f172a;
    font-weight: 700;
    font-size: 1.02rem;
  }

  .version-badge {
    font-family: var(--font-mono);
    color: #334155;
    font-size: 0.92rem;
    background-color: #f1f5f9;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    border: 1px solid #e2e8f0;
    display: inline-block;
  }

  @media (max-width: 768px) {
    .format-section {
      padding: 4rem 0;
    }

    .format-cards-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .format-card {
      padding: 1.75rem 1.5rem;
    }

    .languages-block {
      margin-top: 2.75rem;
    }

    .languages-table th,
    .languages-table td {
      padding: 12px 16px;
    }
  }
</style>
