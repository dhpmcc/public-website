---
import SectionHeading from './SectionHeading.astro';
import { supportedLanguages } from '../config/site';
---

<section id="languages" class="content-container languages-section">
  <SectionHeading
    number="02"
    title="Supported Languages"
  />

  <div class="languages-content">
    <div class="table-responsive">
      <table class="languages-table">
        <thead>
          <tr>
            <th>Language</th>
            <th>Version / Standard</th>
          </tr>
        </thead>
        <tbody>
          {supportedLanguages.map((lang) => (
            <tr>
              <td><strong>{lang.name}</strong></td>
              <td>{lang.standard}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .languages-section {
    padding-top: 0.5rem;
    padding-bottom: 0.75rem;
  }

  .languages-content {
    max-width: 880px;
    margin: 0 auto;
  }

  .table-responsive {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin: 1rem 0;
  }

  .languages-table {
    border-collapse: collapse;
    width: 100%;
    margin: 0;
    border: 1px solid #e2e8f0;
    min-width: 320px;
  }

  .languages-table th,
  .languages-table td {
    border: 1px solid #e2e8f0;
    padding: 10px 14px;
    text-align: left;
    font-size: 0.95rem;
  }

  .languages-table th {
    background-color: #f8fafc;
    font-weight: 600;
    color: #1a202c;
  }
</style>
