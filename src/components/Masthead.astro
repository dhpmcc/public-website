---
import { siteConfig } from '../config/site';
---

<!-- Simple Header Banner -->
<section id="top" class="hero-section">
  <div class="hero-banner" aria-label="Competition Banner">
    <div class="slide-content">
      <p class="slide-badge">DHPMCC // {siteConfig.year}</p>
      <h1 class="slide-title">Daniel H. Plotnick Memorial Computing Competition</h1>
      <p class="slide-tagline">March 13, 2027 at the Bergen County Academies in Hackensack, New Jersey</p>
    </div>
  </div>
</section>

<style>
  .hero-section {
    margin-bottom: 0;
  }

  .hero-banner {
    position: relative;
    width: 100%;
    min-height: 390px;
    background-color: #111418;
    background: radial-gradient(circle at center, #2d3748 0%, #11151a 100%);
    display: flex;
    align-items: center;
  }

  .slide-content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2.5rem 2rem;
    width: 100%;
    color: #ffffff;
  }

  .slide-badge {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #cbd5e0;
    text-transform: uppercase;
    margin: 0 0 0.5rem 0;
  }

  .slide-title {
    font-size: 2.35rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.18;
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.015em;
    max-width: 980px;
  }

  .slide-tagline {
    font-size: 1.15rem;
    color: #e2e8f0;
    margin: 0;
    line-height: 1.5;
    max-width: 850px;
  }

  @media (max-width: 720px) {
    .hero-banner {
      min-height: 320px;
      height: auto;
    }

    .slide-title {
      font-size: 1.75rem;
    }

    .slide-tagline {
      font-size: 1.05rem;
    }
  }

  @media (max-width: 540px) {
    .hero-banner {
      min-height: 290px;
      height: auto;
    }

    .slide-content {
      padding: 1.5rem 1.25rem;
    }

    .slide-badge {
      font-size: 0.78rem;
      margin-bottom: 0.35rem;
    }

    .slide-title {
      font-size: 1.45rem;
      line-height: 1.22;
      margin-bottom: 0.5rem;
    }

    .slide-tagline {
      font-size: 0.95rem;
      line-height: 1.4;
    }
  }
</style>
