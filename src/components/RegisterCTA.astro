---
import SectionHeading from './SectionHeading.astro';
import { siteConfig } from '../config/site';
---

<section class="content-section" id="register">
  <SectionHeading
    number="09"
    title="Registration"
    subtitle="Secure your place for the competition at Bergen County Academies."
  />

  <div class="register-block">
    <div class="register-inner">
      <span class="mono register-kicker">READY TO COMPETE?</span>
      <h3 class="register-headline">Contest Registration Portal</h3>
      <p class="register-copy">
        Registration for DHPMCC will be handled online. Space is strictly limited by workstation capacity in the Bergen County Academies computer laboratories.
      </p>

      <div class="register-action-row">
        <a
          href={siteConfig.registrationUrl}
          class="btn btn-primary btn-large"
          rel="noopener noreferrer"
        >
          [ REGISTER FOR DHPMCC ]
        </a>
      </div>

      <div class="register-meta mono">
        <span>TARGET URL: <code>{siteConfig.registrationUrl}</code></span>
        <span>•</span>
        <span>INQUIRIES: <code>{siteConfig.contactEmail}</code></span>
      </div>
    </div>
  </div>
</section>

<style>
  .content-section {
    margin-bottom: 3.5rem;
  }

  .register-block {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-medium);
    padding: 2.25rem 2rem;
    border-radius: 2px;
    position: relative;
  }

  .register-inner {
    max-width: 65ch;
  }

  .register-kicker {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.4rem;
  }

  .register-headline {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.65rem;
    letter-spacing: -0.01em;
  }

  .register-copy {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .register-action-row {
    margin-bottom: 1.25rem;
  }

  .btn-large {
    padding: 0.8rem 1.75rem;
    font-size: 0.92rem;
  }

  .register-meta {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .register-block {
      padding: 1.5rem 1.25rem;
    }

    .btn-large {
      width: 100%;
      text-align: center;
    }
  }
</style>
