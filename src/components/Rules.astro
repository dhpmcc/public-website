---
import SectionHeading from './SectionHeading.astro';
import { rulesSummary, siteConfig } from '../config/site';
---

<section id="rules">
  <SectionHeading
    number="03"
    title="Rules & Contest Integrity"
    subtitle="Essential guidelines governing eligibility, fair play, and automated scoring."
  />

  <p>
    DHPMCC is conducted under strict competitive programming regulations. Competitors are expected to read and adhere to all contest conduct guidelines.
  </p>

  <ol>
    {rulesSummary.map((rule) => (
      <li>
        <strong>{rule.topic}:</strong> {rule.summary}
      </li>
    ))}
  </ol>

  <p>
    <a href={siteConfig.rulesUrl}>Read the full contest rules &amp; honor code &rarr;</a>
  </p>
</section>
