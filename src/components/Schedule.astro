---
import SectionHeading from './SectionHeading.astro';
---

<section class="content-section" id="schedule">
  <SectionHeading
    number="03"
    title="Schedule of Events"
    subtitle="Competition day timeline for February 20, 2027. Preliminary outline subject to final administrative confirmation."
  />

  <div class="schedule-notice mono">
    <span class="notice-icon">ℹ</span>
    <span>STATUS: <span class="placeholder-tag">[FINAL SCHEDULE]</span> — Detailed time blocks will be published upon finalization of room assignments and registration rosters.</span>
  </div>

  <div class="table-wrapper">
    <table class="data-table schedule-table">
      <thead>
        <tr>
          <th style="width: 25%;">TIME</th>
          <th style="width: 50%;">EVENT</th>
          <th style="width: 25%;">LOCATION</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="mono">[FINAL SCHEDULE]</td>
          <td>Competitor Check-in & System Diagnostics Setup</td>
          <td>Auditorium Lobby / BCA</td>
        </tr>
        <tr>
          <td class="mono">[FINAL SCHEDULE]</td>
          <td>Opening Remarks & Contest Briefing</td>
          <td>Main Auditorium / BCA</td>
        </tr>
        <tr>
          <td class="mono">[FINAL SCHEDULE]</td>
          <td>DHPMCC Competition Window</td>
          <td>Designated Computer Labs & Classrooms</td>
        </tr>
        <tr>
          <td class="mono">[FINAL SCHEDULE]</td>
          <td>Editorial Problem Walkthrough & Guest Speaker</td>
          <td>Main Auditorium / BCA</td>
        </tr>
        <tr>
          <td class="mono">[FINAL SCHEDULE]</td>
          <td>Awards Ceremony & Closing Remarks</td>
          <td>Main Auditorium / BCA</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<style>
  .content-section {
    margin-bottom: 3.5rem;
  }

  .schedule-notice {
    font-size: 0.82rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border);
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .notice-icon {
    color: var(--accent);
    font-weight: 700;
  }

  .schedule-table td:first-child {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }
</style>
