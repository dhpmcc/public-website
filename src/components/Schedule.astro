---
import SectionHeading from './SectionHeading.astro';
import { contestSchedule } from '../config/site';
---

<section id="schedule" class="schedule-section">
  <div class="content-container">
    <SectionHeading
      title="Schedule"
    />

    <div class="schedule-content">
      <div class="table-responsive">
        <table class="schedule-table">
          <thead>
            <tr>
              <th scope="col" class="time-header">Time</th>
              <th scope="col" class="event-header">Event</th>
            </tr>
          </thead>
          <tbody>
            {contestSchedule.map((item) => (
              <tr>
                <td class="time-cell">
                  <span class="time-text">{item.time}</span>
                </td>
                <td class="event-cell">
                  <div class="event-title">{item.event}</div>
                  {item.description && (
                    <div class="event-description">{item.description}</div>
                  )}
                  {item.link && (
                    <div class="event-link-wrap">
                      <a href={item.link} class="event-link">
                        <span>{item.linkLabel || "Learn more"}</span>
                        <svg class="event-link-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <line x1="5" y1="12" x2="19" y2="12"></line>
                          <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                      </a>
                    </div>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .schedule-section {
    width: 100%;
    background-color: #f8fafc;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    padding: 6.5rem 0;
  }

  .schedule-content {
    max-width: 960px;
    margin: 0 auto;
  }

  /* Schedule Table */
  .table-responsive {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background-color: #ffffff;
    box-shadow: 0 4px 24px -2px rgba(0, 0, 0, 0.05);
    margin: 0;
  }

  .schedule-table {
    border-collapse: collapse;
    width: 100%;
    min-width: 340px;
    margin: 0;
  }

  .schedule-table th,
  .schedule-table td {
    padding: 20px 26px;
    text-align: left;
    border-bottom: 1px solid #f1f5f9;
  }

  .schedule-table tr:last-child td {
    border-bottom: none;
  }

  .schedule-table th {
    background-color: #0f172a;
    color: #ffffff;
    font-weight: 600;
    letter-spacing: 0.02em;
    font-size: 0.95rem;
  }

  .time-header {
    width: 28%;
    white-space: nowrap;
  }

  .event-header {
    width: 72%;
  }

  .schedule-table tbody tr {
    background-color: #ffffff;
    transition: background-color 0.15s ease;
  }

  .schedule-table tbody tr:hover {
    background-color: #f8fafc;
  }

  .time-cell {
    white-space: nowrap;
    vertical-align: top;
  }

  /* Natural time text styling - no box */
  .time-text {
    font-weight: 700;
    font-size: 0.98rem;
    color: #8b0000;
    letter-spacing: -0.01em;
  }

  .event-cell {
    vertical-align: top;
  }

  .event-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.35;
  }

  .event-description {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #64748b;
    margin-top: 0.35rem;
  }

  .event-link-wrap {
    margin-top: 0.65rem;
  }

  .event-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #8b0000;
    font-weight: 600;
    font-size: 0.93rem;
    text-decoration: underline;
    transition: color 0.15s ease;
  }

  .event-link:hover {
    color: #500000;
    text-decoration: underline;
  }

  .event-link-icon {
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }

  .event-link:hover .event-link-icon {
    transform: translateX(3px);
  }

  @media (max-width: 768px) {
    .schedule-section {
      padding: 4rem 0;
    }

    .schedule-table th,
    .schedule-table td {
      padding: 14px 18px;
    }

    .time-header,
    .time-cell {
      width: 35%;
    }

    .time-text {
      font-size: 0.9rem;
    }

    .event-title {
      font-size: 1rem;
    }

    .event-description {
      font-size: 0.88rem;
    }
  }
</style>
