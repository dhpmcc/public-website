---
interface Props {
  number?: string;
  title: string;
  id?: string;
  subtitle?: string;
}

const { title, id, subtitle } = Astro.props;
---

<header id={id} class="section-header">
  <h2 class="section-title">{title}</h2>
  {subtitle && <p class="section-subtitle"><em>{subtitle}</em></p>}
</header>

<style>
  .section-header {
    margin-top: 2rem;
    margin-bottom: 1.15rem;
    text-align: center;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: #111111;
    margin: 0 0 0.35rem 0;
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    margin: 0 auto;
    color: #555555;
    font-size: 1rem;
    line-height: 1.45;
    max-width: 960px;
  }
</style>
