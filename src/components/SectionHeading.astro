---
interface Props {
  number?: string;
  title: string;
  id?: string;
  subtitle?: string;
  eyebrow?: string;
}

const { title, id, subtitle, eyebrow } = Astro.props;
---

<header id={id} class="section-header">
  {eyebrow && <span class="section-eyebrow">{eyebrow}</span>}
  <h2 class="section-title">{title}</h2>
  {subtitle && <p class="section-subtitle">{subtitle}</p>}
</header>

<style>
  .section-header {
    margin-top: 0;
    margin-bottom: 3.5rem;
    text-align: center;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #8b0000;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-size: clamp(2.15rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: #0f172a;
    margin: 0;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .section-subtitle {
    margin: 0.95rem auto 0 auto;
    color: #64748b;
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 720px;
  }

  @media (max-width: 640px) {
    .section-header {
      margin-bottom: 2.25rem;
    }

    .section-subtitle {
      font-size: 1rem;
    }
  }
</style>
