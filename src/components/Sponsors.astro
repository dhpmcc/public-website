---
import SectionHeading from './SectionHeading.astro';
import { sponsors } from '../config/site';

const mainSponsors = sponsors.main || [];
---

<section id="sponsors" class="sponsors-section">
  <div class="content-container">
    <SectionHeading
      title="Sponsors"
    />

    <p class="sponsor-inquiry">
      <a href="mailto:kabsek30@bergen.org?subject=DHPMCC%20Sponsorship%20Inquiry">Interested in Sponsoring?</a>
    </p>

    <!-- Main Sponsors (Big section) -->
    <div class="sponsors-main">
      {mainSponsors.length > 0 ? (
        <ul class="sponsor-list main-sponsor-list">
          {mainSponsors.map((sponsor) => (
            <li class="sponsor-item main-sponsor-item">
              <a href={sponsor.url} target="_blank" rel="noopener noreferrer" class="sponsor-link main-sponsor-link" aria-label={`Visit ${sponsor.name}`}>
                {sponsor.logo && <img src={sponsor.logo} alt={`${sponsor.name} logo`} class="sponsor-logo main-sponsor-logo" />}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-notice">[Sponsor opportunities available]</p>
      )}
    </div>

    <!-- Full-width divider separating main and in-kind sponsors -->
    <hr class="sponsors-divider" />

    <!-- In-Kind Sponsors (Small section) -->
    <div class="sponsors-inkind">
      {sponsors.inKind.length > 0 ? (
        <ul class="sponsor-list inkind-list">
          {sponsors.inKind.map((sponsor) => (
            <li class="sponsor-item inkind-item">
              <a href={sponsor.url} target="_blank" rel="noopener noreferrer" class="sponsor-link inkind-link" aria-label={`Visit ${sponsor.name}`}>
                {sponsor.logo && <img src={sponsor.logo} alt={`${sponsor.name} logo`} class="sponsor-logo inkind-logo" />}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-notice">[Sponsor opportunities available]</p>
      )}
    </div>
  </div>
</section>

<style>
  .sponsors-section {
    width: 100%;
    background-color: #ffffff;
    padding: 6.5rem 0;
    text-align: center;
  }

  /* Natural link styling moved closer to the Sponsors header */
  .sponsor-inquiry {
    margin-top: -2.25rem;
    margin-bottom: 2.75rem;
    font-size: 1.05rem;
  }

  .sponsor-inquiry a {
    color: var(--color-link);
    text-decoration: underline;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .sponsor-inquiry a:hover {
    color: var(--color-link-hover);
  }

  /* Big Section: Main Sponsors */
  .sponsors-main {
    margin: 2rem 0 3rem 0;
  }

  .sponsor-list {
    list-style: none;
    padding-left: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  .sponsor-item {
    margin: 0;
  }

  .sponsor-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .main-sponsor-list {
    gap: clamp(2.5rem, 6vw, 4.5rem);
    padding: 1rem 0;
  }

  .main-sponsor-link:hover,
  .main-sponsor-link:focus-visible {
    transform: translateY(-3px);
  }

  .main-sponsor-logo {
    max-height: 120px;
    max-width: 320px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    margin: 0 auto;
    transition: filter 0.2s ease;
  }

  /* Clear full-width divider spanning the entire length */
  .sponsors-divider {
    border: 0;
    border-top: 1.5px solid #cbd5e1;
    width: 100%;
    max-width: 100%;
    margin: 3.5rem 0 2.5rem 0;
  }

  /* In-Kind Sponsors */
  .sponsors-inkind {
    margin: 1.5rem 0;
  }

  .inkind-list {
    gap: clamp(1.75rem, 4vw, 3rem);
    padding: 0.75rem 0;
  }

  .inkind-item {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .inkind-link {
    padding: 0.35rem 0.65rem;
    opacity: 0.88;
    border-radius: 8px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .inkind-link:hover,
  .inkind-link:focus-visible {
    opacity: 1;
    transform: translateY(-2px);
  }

  .inkind-logo {
    max-height: 48px;
    max-width: 140px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    margin: 0 auto;
  }

  .empty-notice {
    color: #64748b;
    font-size: 0.95rem;
    font-style: italic;
    margin: 1rem 0;
  }

  @media (max-width: 768px) {
    .sponsors-section {
      padding: 4rem 0;
    }

    .main-sponsor-list {
      gap: 2rem;
    }

    .main-sponsor-logo {
      max-height: 80px;
      max-width: 220px;
    }

    .inkind-list {
      gap: 1.5rem;
    }

    .inkind-logo {
      max-height: 32px;
      max-width: 100px;
    }
  }
</style>
