---
import SectionHeading from './SectionHeading.astro';
import { sponsors } from '../config/site';
---

<section id="sponsors" class="content-container sponsors-section">
  <SectionHeading
    number="03"
    title="Sponsors"
  />

  <p class="sponsor-inquiry">
    <a href="mailto:kabsek30@bergen.org?subject=DHPMCC%20Sponsorship%20Inquiry">Interested in Sponsoring?</a>
  </p>

  <div class="tier-block">
    <h3 class="tier-title">Platinum Tier</h3>
    {sponsors.platinum.length > 0 ? (
      <ul class="sponsor-list">
        {sponsors.platinum.map((sponsor) => (
          <li class="sponsor-item">
            <a href={sponsor.url} target="_blank" rel="noopener noreferrer">
            {sponsor.logo && <img src={sponsor.logo} alt={`${sponsor.name} logo`} class="sponsor-logo" />}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-notice">[Sponsor opportunities available]</p>
    )}
  </div>

  <div class="tier-block">
    <h3 class="tier-title">Gold Tier</h3>
    {sponsors.gold.length > 0 ? (
      <ul class="sponsor-list">
        {sponsors.gold.map((sponsor) => (
          <li class="sponsor-item">
            <a href={sponsor.url} target="_blank" rel="noopener noreferrer">
            {sponsor.logo && <img src={sponsor.logo} alt={`${sponsor.name} logo`} class="sponsor-logo" />}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-notice">[Sponsor opportunities available]</p>
    )}
  </div>

  <div class="tier-block">
    <h3 class="tier-title">Silver Tier</h3>
    {sponsors.silver.length > 0 ? (
      <ul class="sponsor-list">
        {sponsors.silver.map((sponsor) => (
          <li class="sponsor-item">
            <a href={sponsor.url} target="_blank" rel="noopener noreferrer">
            {sponsor.logo && <img src={sponsor.logo} alt={`${sponsor.name} logo`} class="sponsor-logo" />}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-notice">[Sponsor opportunities available]</p>
    )}
  </div>

  <div class="tier-block">
    <h3 class="tier-title">In-Kind Sponsors</h3>
    {sponsors.inKind.length > 0 ? (
      <ul class="sponsor-list">
        {sponsors.inKind.map((sponsor) => (
          <li class="sponsor-item">
            <a href={sponsor.url} target="_blank" rel="noopener noreferrer">
            {sponsor.logo && <img src={sponsor.logo} alt={`${sponsor.name} logo`} class="sponsor-logo" />}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-notice">[Sponsor opportunities available]</p>
    )}
  </div>
</section>

<style>
  .sponsors-section {
    padding-top: 0.5rem;
    padding-bottom: 1.25rem;
    text-align: center;
  }

  .sponsor-inquiry {
    margin-bottom: 1.25rem;
    font-size: 0.98rem;
  }

  .tier-block {
    margin-bottom: 1.5rem;
  }

  .tier-title {
    margin-top: 1rem;
    margin-bottom: 0.2rem;
    font-size: 1.15rem;
    color: #1a202c;
  }

  .tier-desc {
    color: #718096;
    font-size: 0.9rem;
    margin: 0 0 0.65rem 0;
  }

  .sponsor-list {
    list-style: none;
    padding-left: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin: 0.75rem 0;
  }

  .sponsor-item {
    margin: 0;
  }

  .sponsor-logo {
    max-height: 100px;
    max-width: 300px;
    object-fit: contain;
    display: block;
    margin: 0 auto 0.4rem auto;
  }

  .empty-notice {
    color: #718096;
    font-size: 0.95rem;
    font-style: italic;
    margin: 0.5rem 0;
  }
</style>
