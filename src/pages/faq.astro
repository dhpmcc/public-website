---
import Layout from '../layouts/Layout.astro';
import { faqs, siteConfig } from '../config/site';
---

<Layout title={`Frequently Asked Questions | DHPMCC ${siteConfig.year}`} description="Operational, technical, and logistical information regarding the Daniel H. Plotnick Memorial Computing Competition.">
  <div class="content-container faq-main">
    <header class="faq-intro">
      <p class="faq-eyebrow">DHPMCC // {siteConfig.year}</p>
      <h1 class="faq-title">Frequently Asked Questions</h1>
      <p class="faq-subtitle">
        Everything competitors, coaches, and parents usually want to know. Still wondering about something? Reach out at <a href="mailto:kabsek30@bergen.org">kabsek30@bergen.org</a>.
      </p>
    </header>

    <div class="faq-list">
      {faqs.map((item, index) => {
        const num = String(index + 1).padStart(2, '0');
        return (
          <details class="faq-item">
            <summary class="faq-summary">
              <span class="faq-num" aria-hidden="true">{num}</span>
              <span class="faq-question">{item.question}</span>
              <span class="faq-toggle" aria-hidden="true"></span>
            </summary>
            <div class="faq-content">
              <p>{item.answer}</p>
            </div>
          </details>
        );
      })}
    </div>

  </div>
</Layout>

<style>
  .faq-main {
    padding-top: 4.5rem;
    padding-bottom: 5.5rem;
    max-width: 980px;
    margin: 0 auto;
  }

  /* Header */
  .faq-intro {
    max-width: 46rem;
    margin-bottom: 3.5rem;
  }

  .faq-eyebrow {
    margin: 0 0 0.8rem 0;
    color: var(--color-link, #8b0000);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .faq-title {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: #0f172a;
  }

  .faq-subtitle {
    margin: 1.15rem 0 0 0;
    font-size: 1.12rem;
    line-height: 1.7;
    color: #475569;
  }

  .faq-subtitle a {
    color: var(--color-link, #8b0000);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    font-weight: 600;
  }

  /* FAQ Accordion List (hackPHS Style) */
  .faq-list {
    border-top: 1px solid #e2e8f0;
  }

  .faq-item {
    border-bottom: 1px solid #e2e8f0;
    transition: background-color 0.15s ease;
  }

  .faq-item[open] {
    background-color: #fafbfd;
  }

  .faq-summary {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr 2rem;
    gap: 1rem;
    align-items: center;
    padding: 1.45rem 0.5rem;
    list-style: none;
    cursor: pointer;
    user-select: none;
    transition: color 0.15s ease;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-num {
    color: #94a3b8;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .faq-question {
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.02em;
    line-height: 1.35;
    transition: color 0.15s ease;
  }

  .faq-summary:hover .faq-question {
    color: var(--color-link, #8b0000);
  }

  /* Plus / Minus Indicator */
  .faq-toggle {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
  }

  .faq-toggle::before,
  .faq-toggle::after {
    content: "";
    position: absolute;
    background-color: #64748b;
    border-radius: 1px;
    transition: transform 0.22s ease, background-color 0.15s ease;
  }

  /* Horizontal line */
  .faq-toggle::before {
    width: 0.95rem;
    height: 2px;
  }

  /* Vertical line */
  .faq-toggle::after {
    width: 2px;
    height: 0.95rem;
  }

  .faq-summary:hover .faq-toggle::before,
  .faq-summary:hover .faq-toggle::after {
    background-color: var(--color-link, #8b0000);
  }

  /* Rotate vertical bar to horizontal when open (transforms plus to minus) */
  .faq-item[open] .faq-toggle::after {
    transform: rotate(90deg);
    opacity: 0;
  }

  .faq-content {
    padding: 0 1rem 1.65rem 4.25rem;
  }

  .faq-content p {
    margin: 0;
    color: #475569;
    font-size: 1.02rem;
    line-height: 1.78;
    max-width: 48rem;
  }

  /* Page Footer */
  @media (max-width: 640px) {
    .faq-main {
      padding-top: 2.5rem;
      padding-bottom: 3.5rem;
    }

    .faq-intro {
      margin-bottom: 2.25rem;
    }

    .faq-summary {
      grid-template-columns: 2rem 1fr 1.5rem;
      gap: 0.65rem;
      padding: 1.15rem 0.25rem;
    }

    .faq-num {
      font-size: 0.75rem;
    }

    .faq-question {
      font-size: 1.05rem;
    }

    .faq-content {
      padding: 0 0.25rem 1.25rem 2.65rem;
    }

    .faq-content p {
      font-size: 0.95rem;
    }
  }
</style>
