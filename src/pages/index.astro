---
import Layout from '../layouts/Layout.astro';
import Masthead from '../components/Masthead.astro';
import About from '../components/About.astro';
import Format from '../components/Format.astro';
import Divisions from '../components/Divisions.astro';
import Schedule from '../components/Schedule.astro';
import Sponsors from '../components/Sponsors.astro';
import { siteConfig } from '../config/site';
---

<Layout>
  <Masthead />
  
  <!-- Classic Registration Callout with Signature Red Accent Line -->
  <div class="content-container">
    <div class="home-summary">
      <blockquote>
        Join us for the first annual DHPMCC! Registration is now open ($40 fee): 
        <a href={siteConfig.registrationUrl} target="_blank" rel="noopener noreferrer" class="summary-register-link">Register Here</a>
      </blockquote>
    </div>
  </div>

  <About />
  <Format />
  <Divisions />
  <Schedule />
  <Sponsors />

  <!-- Prominent Closing Call-to-Action Section -->
  <section class="bottom-cta-section">
    <div class="content-container">
      <div class="bottom-cta-card">
        <div class="bottom-cta-info">
          <p class="bottom-cta-eyebrow">DHPMCC // {siteConfig.year}</p>
          <h2 class="bottom-cta-title">Ready to Compete?</h2>
          <p class="bottom-cta-desc">
            Join students across the region for an exciting day of algorithmic problem solving, CS seminars, and awards at Bergen County Academies.
          </p>
        </div>
        <div class="bottom-cta-action">
          <a href={siteConfig.registrationUrl} target="_blank" rel="noopener noreferrer" class="bottom-cta-btn">
            Register for DHPMCC
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-summary {
    padding-top: 2rem;
    padding-bottom: 1rem;
  }

  .home-summary blockquote {
    margin: 0;
    padding: 0.4rem 0 0.4rem 1.25rem;
    border-left: 4px solid #8b0000;
    border-left: 4px solid var(--color-link, #8b0000);
    font-size: 1.05rem;
    line-height: 1.6;
    color: #374151;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .summary-register-link {
    color: var(--color-link, #8b0000);
    text-decoration: underline;
    font-weight: 700;
    transition: color 0.15s ease;
  }

  .summary-register-link:hover {
    color: var(--color-link-hover, #500000);
    text-decoration: underline;
  }

  /* Bottom Closing CTA Section */
  .bottom-cta-section {
    width: 100%;
    background-color: #f8fafc;
    border-top: 1px solid #e2e8f0;
    padding: 5rem 0;
  }

  .bottom-cta-card {
    max-width: 1080px;
    margin: 0 auto;
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-top: 4px solid var(--color-link, #8b0000);
    border-radius: 16px;
    padding: 3rem 3.5rem;
    box-shadow: 0 4px 24px -2px rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .bottom-cta-info {
    max-width: 620px;
  }

  .bottom-cta-eyebrow {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-link, #8b0000);
    margin: 0 0 0.45rem 0;
  }

  .bottom-cta-title {
    font-size: 2rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin: 0 0 0.65rem 0;
    line-height: 1.25;
  }

  .bottom-cta-desc {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  .bottom-cta-action {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .bottom-cta-btn {
    display: inline-block;
    background-color: var(--color-link, #8b0000);
    color: #ffffff !important;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    padding: 0.7rem 1.6rem;
    border-radius: 4px;
    border: 1px solid #700000;
    text-decoration: none !important;
    box-shadow: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }

  .bottom-cta-btn:hover {
    background-color: #700000;
    border-color: #550000;
  }

  @media (max-width: 820px) {
    .bottom-cta-section {
      padding: 3.5rem 0;
    }

    .bottom-cta-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 2.25rem 1.75rem;
      gap: 1.75rem;
    }

    .bottom-cta-title {
      font-size: 1.65rem;
    }

    .bottom-cta-action {
      width: 100%;
    }

    .bottom-cta-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
