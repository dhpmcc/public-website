---
import Layout from '../layouts/Layout.astro';
import Masthead from '../components/Masthead.astro';
import About from '../components/About.astro';
import Format from '../components/Format.astro';
import Divisions from '../components/Divisions.astro';
import Schedule from '../components/Schedule.astro';
import Sponsors from '../components/Sponsors.astro';
import { siteConfig } from '../config/site';
---

<Layout>
  <Masthead />
  
  <!-- Classic Registration Callout with Signature Red Accent Line -->
  <div class="content-container">
    <div class="home-summary">
      <blockquote>
        Join us for the first annual DHPMCC! Registration is now open ($40 fee): 
        <a href={siteConfig.registrationUrl} target="_blank" rel="noopener noreferrer" class="summary-register-link">Register Here</a>
      </blockquote>
    </div>
  </div>

  <About />
  <Format />
  <Divisions />
  <Schedule />
  <Sponsors />

  <!-- Closing Call-to-Action Bar -->
  <section class="bottom-cta-section">
    <div class="content-container">
      <div class="bottom-cta-wrap">
        <h2 class="bottom-cta-title">Ready to Compete?</h2>
        <a href={siteConfig.registrationUrl} target="_blank" rel="noopener noreferrer" class="bottom-cta-btn">
          Register for DHPMCC
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-summary {
    padding-top: 2rem;
    padding-bottom: 1rem;
  }

  .home-summary blockquote {
    margin: 0;
    padding: 0.4rem 0 0.4rem 1.25rem;
    border-left: 4px solid #8b0000;
    border-left: 4px solid var(--color-link, #8b0000);
    font-size: 1.05rem;
    line-height: 1.6;
    color: #374151;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .summary-register-link {
    color: var(--color-link, #8b0000);
    text-decoration: underline;
    font-weight: 700;
    transition: color 0.15s ease;
  }

  .summary-register-link:hover {
    color: var(--color-link-hover, #500000);
    text-decoration: underline;
  }

  /* Bottom Closing CTA Bar */
  .bottom-cta-section {
    width: 100%;
    background-color: #ffffff;
    padding: 3rem 0 5.5rem 0;
  }

  .bottom-cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1.25rem;
  }

  .bottom-cta-title {
    font-size: 2.15rem;
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.2;
    text-align: center;
  }

  .bottom-cta-btn {
    display: inline-block;
    background-color: var(--color-link, #8b0000);
    color: #ffffff !important;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    padding: 0.72rem 1.65rem;
    border-radius: 4px;
    border: 1px solid #700000;
    text-decoration: none !important;
    box-shadow: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }

  .bottom-cta-btn:hover {
    background-color: #700000;
    border-color: #550000;
  }

  @media (max-width: 680px) {
    .bottom-cta-section {
      padding: 2rem 0 4.5rem 0;
    }

    .bottom-cta-title {
      font-size: 1.8rem;
    }

    .bottom-cta-wrap {
      gap: 1rem;
    }
  }
</style>
