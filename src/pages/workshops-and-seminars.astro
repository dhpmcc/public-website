---
import Layout from '../layouts/Layout.astro';
import { seminarSpeakers, siteConfig } from '../config/site';
---

<Layout title={`Workshops & Seminars | DHPMCC ${siteConfig.year}`} description="Distinguished guest speakers and technical seminars taking place during the DHPMCC competition lunch window.">
  <div class="content-container workshops-main">
    <header class="workshops-intro">
      <p class="workshops-eyebrow">DHPMCC // {siteConfig.year}</p>
      <h1 class="workshops-title">Workshops &amp; Seminars</h1>
      <p class="workshops-subtitle">
        Distinguished guest speakers and technical seminars taking place during the competition lunch window (12:30 PM – 2:00 PM).
      </p>
    </header>

    <!-- 1 Speaker Per Row - Wide Landscape Cards -->
    <section class="speakers-section" aria-label="Featured Speakers">
      <div class="speakers-list">
        {seminarSpeakers.map((speaker) => (
          <article class="speaker-card">
            <div class="speaker-photo-pane">
              <img
                src={speaker.photo}
                alt={`Photo of ${speaker.name}`}
                class="speaker-photo"
                loading="eager"
              />
            </div>

            <div class="speaker-content-pane">
              <div class="speaker-header-block">
                <h2 class="speaker-name">{speaker.name}</h2>
                <p class="speaker-role">{speaker.role}</p>
              </div>

              <div class="topic-box">
                <span class="topic-label">Lecture Topic</span>
                <p class="topic-title">{speaker.lectureTopic}</p>
              </div>

              <p class="speaker-bio">{speaker.bio}</p>
            </div>
          </article>
        ))}

        <!-- Upcoming Speaker Slot (Wide Horizontal Banner) -->
        <div class="placeholder-card">
          <div class="placeholder-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
              <line x1="12" y1="19" x2="12" y2="22"></line>
            </svg>
          </div>
          <div class="placeholder-text-wrap">
            <h2 class="placeholder-title">More Speakers Coming Soon</h2>
            <p class="placeholder-text">
              Additional guest lectures and workshop details will be announced leading up to contest day.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .workshops-main {
    padding-top: 5rem;
    padding-bottom: 6rem;
    max-width: 1040px;
    margin: 0 auto;
  }

  /* Header */
  .workshops-intro {
    max-width: 48rem;
    margin-bottom: 3.5rem;
  }

  .workshops-eyebrow {
    margin: 0 0 0.8rem 0;
    color: var(--color-link, #8b0000);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .workshops-title {
    margin: 0;
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: #0f172a;
  }

  .workshops-subtitle {
    margin: 1.15rem 0 0 0;
    font-size: 1.12rem;
    line-height: 1.7;
    color: #475569;
  }

  /* Speakers List - 1 Speaker Per Row (Wide Landscape Cards) */
  .speakers-section {
    width: 100%;
  }

  .speakers-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    width: 100%;
  }

  /* Wide Split Speaker Card */
  .speaker-card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
    display: grid;
    grid-template-columns: 340px 1fr;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .speaker-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px -4px rgba(0, 0, 0, 0.08);
    border-color: #cbd5e1;
  }

  /* Prominent Face Photo Pane */
  .speaker-photo-pane {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 340px;
    background-color: #eaebed;
    overflow: hidden;
  }

  .speaker-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transform: scale(1.42);
    transform-origin: 50% 20%;
    display: block;
  }

  /* Speaker Content Pane */
  .speaker-content-pane {
    padding: 2.75rem 2.85rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .speaker-header-block {
    margin-bottom: 1.25rem;
  }

  .speaker-name {
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    font-weight: 700;
    color: #0f172a;
    letter-spacing: -0.025em;
    margin: 0 0 0.35rem 0;
    line-height: 1.2;
  }

  .speaker-role {
    font-size: 1.02rem;
    font-weight: 600;
    color: #64748b;
    margin: 0;
  }

  /* Topic Box */
  .topic-box {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-left: 4px solid var(--color-link, #8b0000);
    border-radius: 6px;
    padding: 0.95rem 1.35rem;
    margin-bottom: 1.35rem;
  }

  .topic-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-link, #8b0000);
    margin-bottom: 0.3rem;
  }

  .topic-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
    line-height: 1.35;
  }

  .speaker-bio {
    font-size: 1.02rem;
    line-height: 1.75;
    color: #475569;
    margin: 0;
  }

  /* Upcoming Speaker Slot (Wide Horizontal Banner) */
  .placeholder-card {
    background-color: #fafbfd;
    border: 2px dashed #cbd5e1;
    border-radius: 16px;
    padding: 2.5rem 2.5rem;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    color: #64748b;
  }

  .placeholder-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #94a3b8;
  }

  .placeholder-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #334155;
    margin: 0 0 0.35rem 0;
  }

  .placeholder-text {
    font-size: 1rem;
    color: #64748b;
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .speaker-card {
      grid-template-columns: 1fr;
    }

    .speaker-photo-pane {
      min-height: 280px;
      height: 300px;
    }

    .speaker-content-pane {
      padding: 2rem 1.75rem;
    }

    .placeholder-card {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
      padding: 2rem 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .workshops-main {
      padding-top: 3rem;
      padding-bottom: 4rem;
    }

    .workshops-intro {
      margin-bottom: 2.25rem;
    }

    .speaker-content-pane {
      padding: 1.65rem 1.35rem;
    }

    .speaker-name {
      font-size: 1.5rem;
    }

    .topic-title {
      font-size: 1.05rem;
    }
  }
</style>
